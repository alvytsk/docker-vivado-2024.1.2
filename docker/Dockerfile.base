# Pinned by digest: tags are mutable and the build key must not miss a swap.
FROM ubuntu:22.04@sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc

LABEL org.opencontainers.image.base.digest="sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# en_US.UTF-8 must be GENERATED or vivado aborts; apt lists dropped in this same layer. See README "Known workarounds".
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libtinfo5 libncurses5 \
        libx11-6 libxext6 libxrender1 libxtst6 libxi6 \
        libfreetype6 libfontconfig1 \
        locales ca-certificates gosu \
        unzip zip tar git make python3 net-tools procps && \
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    locale-gen en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 vivado && \
    useradd -u 1000 -g 1000 -m -d /home/vivado -s /bin/bash vivado && \
    chmod 0777 /home/vivado && \
    mkdir -p /work && chown 1000:1000 /work
